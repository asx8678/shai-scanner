{
  "name": "shai-scanner",
  "version": "4.6.5",
  "description": "Dependency-light Shai-Hulud, Mini Shai-Hulud, OSV, and GitHub Advisory scanner for npm projects",
  "keywords": [
    "security",
    "npm",
    "supply-chain",
    "malware",
    "scanner",
    "shai-hulud",
    "mini-shai-hulud",
    "ioc"
  ],
  "author": "Security Tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asx8678/shai-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/asx8678/shai-scanner/issues"
  },
  "homepage": "https://github.com/asx8678/shai-scanner#readme",
  "type": "module",
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    }
  },
  "bin": {
    "shai-scanner": "src/cli.js"
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "examples",
    "AUDIT_NOTES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node test/self-test.js",
    "scan:self": "node src/cli.js --scan . --offline --no-auto-update",
    "scan:lockfiles": "node src/cli.js --scan . --lockfiles-only --offline --no-auto-update",
    "update-db": "node src/cli.js --update",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
